# executaveis locais (baixados pelo setup)
.tools/

# artefatos de build (somente a pasta da raiz; src/shared/build e codigo)
/build/
*.rbxl
*.rbxlx
*.rbxm
*.rbxmx

# ferramentas
sourcemap.json
.serena/

# artefatos gerados pela radiografia (regeneraveis)
.context/radiografia.md
.context/radiografia.json

# modelos importados do Blender (versionados via LFS)
!assets/models/**/*.rbxm
!assets/models/**/*.rbxmx

# std gerado pelo Selene (regeneravel)
roblox.yml

# autosave do Blender
*.blend1

# renders gerados
art/renders/
