{
  "name": "jogo-roblox",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/shared"
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$path": "src/server"
    },

    "ServerStorage": {
      "$className": "ServerStorage",
      "Vendor": {
        "$className": "Folder",
        "ProfileStore": {
          "$path": "vendor/ProfileStore.luau"
        }
      }
    },

    "Workspace": {
      "$className": "Workspace",
      "$path": "src/world",
      "Terrain": {
        "$className": "Terrain"
      }
    },

    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "ShadowMap",
        "ClockTime": 14.5,
        "Brightness": 2.5,
        "GlobalShadows": true,
        "Ambient": [0.35, 0.35, 0.4],
        "OutdoorAmbient": [0.55, 0.55, 0.6]
      }
    }
  }
}
